# Keep the build context small and never send secrets to the Docker daemon.
.git
.gitignore
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.coverage
htmlcov
.env
.env.*
!.env.example
local-docs
tests
docs
.github
.claude
deploy
monitoring
*.md
Dockerfile
docker-compose*.yml
.pre-commit-config.yaml
