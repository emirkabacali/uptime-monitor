# Copy to .env and adjust. Never commit the real .env file.
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL started by `docker compose up -d postgres` (host port 5433)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/uptime

# Required. At least 32 bytes of random data. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_EXPIRE_MINUTES=60

MAX_MONITORS_PER_USER=20

# Redis: Celery broker and login rate limiting
REDIS_URL=redis://localhost:6379/0

# Checks
FAILURE_THRESHOLD=3
CHECK_RETENTION_DAYS=30
DISPATCH_BATCH_SIZE=500
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Only for tests against local servers. Never true in production.
ALLOW_PRIVATE_TARGETS=false

# Telegram notifications: create a bot with @BotFather and paste its token here.
# Leave empty to disable notifications.
TELEGRAM_BOT_TOKEN=

# Grafana admin password for the local compose stack (http://localhost:3000)
GRAFANA_ADMIN_PASSWORD=change-me-locally
