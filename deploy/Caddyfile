# Caddy obtains and renews a Let's Encrypt certificate for {$DOMAIN} automatically
# and redirects HTTP to HTTPS.
{$DOMAIN} {
	encode zstd gzip

	# Prometheus metrics are internal only: never served to the internet.
	@internal path /metrics /metrics/*
	respond @internal 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy api:8000
}

# Grafana dashboards. Grafana's own login protects it (admin password from .env,
# sign-up and anonymous access disabled).
grafana.{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy grafana:3000
}
