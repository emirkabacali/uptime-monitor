# Production configuration. Copy to the SERVER as ~/uptime-monitor/.env
# (chmod 600). Never commit the real file.

DOMAIN=uptime.example.com
ENVIRONMENT=production
LOG_LEVEL=INFO

# Generate both with: openssl rand -base64 48
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me

TELEGRAM_BOT_TOKEN=

FAILURE_THRESHOLD=3
MAX_MONITORS_PER_USER=20
CHECK_RETENTION_DAYS=30
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Must stay false in production (the application refuses to start otherwise).
ALLOW_PRIVATE_TARGETS=false
